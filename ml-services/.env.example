# Environment variables for ML services

# Flask Configuration
FLASK_APP=app/main.py
FLASK_ENV=development
FLASK_DEBUG=1

# Server Configuration
ML_SERVICE_PORT=5000
ML_SERVICE_HOST=0.0.0.0

# Database Configuration (if needed for direct access)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=atmos_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Model Configuration
MODEL_UPDATE_INTERVAL=weekly
DEFAULT_N_CLUSTERS=5
MIN_ACTIVITIES_FOR_CLUSTERING=10

# API Keys (if needed)
API_SECRET_KEY=your_secret_key_here

# Logging
LOG_LEVEL=INFO
